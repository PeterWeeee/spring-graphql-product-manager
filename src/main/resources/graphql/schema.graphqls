# ==========================================================
# GRAPHQL SCHEMA DEFINITION
# ==========================================================

type Category {
    categoryId: ID!
    categoryName: String!
    icon: String
    status: Int
    products: [Product]
}

type Product {
    productId: ID!
    productName: String!
    quantity: Int!
    unitPrice: Float!
    images: String
    description: String
    discount: Float!
    createDate: String
    status: Int!
    category: Category
}

type CategoryPage {
    content: [Category]
    totalPages: Int!
    totalElements: Int!
    currentPage: Int!
    pageSize: Int!
}

type ProductPage {
    content: [Product]
    totalPages: Int!
    totalElements: Int!
    currentPage: Int!
    pageSize: Int!
}

input CategoryInput {
    categoryName: String!
    icon: String
    status: Int
}

input ProductInput {
    productName: String!
    quantity: Int!
    unitPrice: Float!
    images: String
    description: String
    discount: Float
    status: Int
    categoryId: ID
}

type Query {
    # 1. Hiển thị tất cả product có price từ thấp đến cao hiển thị trong trang home
    productsSortedByPrice: [Product]

    # 2. Lấy tất cả product của 01 category hiển thị trong trang home
    productsByCategory(categoryId: ID!): [Product]

    # 3. Phân trang và tìm kiếm Product
    products(page: Int, size: Int, search: String, categoryId: ID): ProductPage
    productById(id: ID!): Product

    # 3. Phân trang và tìm kiếm Category
    categories(page: Int, size: Int, search: String): CategoryPage
    allCategories: [Category]
    categoryById(id: ID!): Category
}

type Mutation {
    # CRUD Category
    createCategory(input: CategoryInput!): Category
    updateCategory(id: ID!, input: CategoryInput!): Category
    deleteCategory(id: ID!): Boolean

    # CRUD Product
    createProduct(input: ProductInput!): Product
    updateProduct(id: ID!, input: ProductInput!): Product
    deleteProduct(id: ID!): Boolean
}
